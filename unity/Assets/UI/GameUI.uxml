<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="GameUI.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement name="look-area" class="look-area" />

        <!-- ===== HUD ===== -->
        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:VisualElement name="objectives" class="hud-panel objectives" picking-mode="Ignore">
                <ui:Label name="area-title" text="森" class="area-title" picking-mode="Ignore" />
                <ui:VisualElement class="obj-row" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon-drop" picking-mode="Ignore" />
                    <ui:Label name="drop-label" text="森のしずく" class="obj-label" picking-mode="Ignore" />
                    <ui:Label name="drop-count" text="0 / 45" class="obj-count" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="obj-row" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon-place" picking-mode="Ignore" />
                    <ui:Label text="名所" class="obj-label" picking-mode="Ignore" />
                    <ui:Label name="place-count" text="0 / 9" class="obj-count" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="obj-row" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon-bug" picking-mode="Ignore" />
                    <ui:Label text="いきもの" class="obj-label" picking-mode="Ignore" />
                    <ui:Label name="creature-count" text="0 / 16" class="obj-count" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="area-name" text="" class="area-name" picking-mode="Ignore" />

            <!-- 眠っているしゃくとりむしの「z Z」 -->
            <ui:Label name="worm-zzz" text="z z Z" class="worm-zzz hidden" picking-mode="Ignore" />

            <!-- チュートリアル：行き先の上の ▼（名前つき）と、しゃくとりむしのそばの、行き先をさす矢印 -->
            <ui:VisualElement name="tutorial-guide" class="tutorial-guide hidden" picking-mode="Ignore">
                <ui:VisualElement name="tutorial-mark" class="tutorial-mark" picking-mode="Ignore">
                    <ui:Label name="tutorial-mark-label" text="" class="tutorial-mark-label" picking-mode="Ignore" />
                    <ui:Label text="▼" class="tutorial-mark-arrow" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="tutorial-arrow" text="▲" class="tutorial-arrow" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- チュートリアル：いまの練習・押すボタン・めあて -->
            <ui:VisualElement name="tutorial" class="tutorial hidden" picking-mode="Ignore">
                <ui:VisualElement name="tutorial-card" class="tutorial-card" picking-mode="Ignore">
                    <ui:VisualElement class="tutorial-head" picking-mode="Ignore">
                        <ui:Label name="tutorial-step" text="" class="tutorial-step" picking-mode="Ignore" />
                        <ui:Label name="tutorial-title" text="" class="tutorial-title" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="tutorial-keys" class="tutorial-keys" picking-mode="Ignore" />
                    <ui:Label name="tutorial-text" text="" class="tutorial-text" picking-mode="Ignore" />
                    <ui:VisualElement name="tutorial-progress" class="tutorial-progress" picking-mode="Ignore">
                        <ui:VisualElement name="tutorial-progress-fill" class="tutorial-progress-fill" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="tutorial-note" text="" class="tutorial-note" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="top-right" class="top-right" picking-mode="Ignore">
                <ui:VisualElement name="minimap" class="minimap">
                    <ui:VisualElement name="minimap-mask" class="minimap-mask" picking-mode="Ignore">
                        <ui:VisualElement name="minimap-image" class="minimap-image" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="minimap-player" class="minimap-player" picking-mode="Ignore" />
                    <ui:Label text="N" class="minimap-north" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="top-buttons" picking-mode="Ignore">
                    <ui:Button name="map-button" class="round-button">
                        <ui:VisualElement class="icon icon-map" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="collection-button" class="round-button">
                        <ui:VisualElement class="icon icon-book" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="menu-button" class="round-button">
                        <ui:VisualElement class="icon icon-menu" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="fullscreen-button" class="round-button touch-only">
                        <ui:VisualElement class="icon icon-fullscreen" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="banner" class="banner" picking-mode="Ignore">
                <ui:VisualElement class="banner-deco" picking-mode="Ignore" />
                <ui:Label name="banner-sub" text="新たな場所を発見" class="banner-sub" picking-mode="Ignore" />
                <ui:Label name="banner-title" text="" class="banner-title" picking-mode="Ignore" />
                <ui:Label name="banner-desc" text="" class="banner-desc" picking-mode="Ignore" />
                <ui:VisualElement class="banner-deco banner-deco-bottom" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="reticle" class="reticle hidden" picking-mode="Ignore">
                <ui:VisualElement class="reticle-ring" picking-mode="Ignore" />
                <ui:VisualElement class="reticle-dot" picking-mode="Ignore" />
                <ui:Label name="reticle-text" text="" class="reticle-text" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="save-indicator" class="save-indicator" picking-mode="Ignore">
                <ui:VisualElement class="save-leaf" picking-mode="Ignore" />
                <ui:Label text="オートセーブ" class="save-text" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="creature-card" class="creature-card">
                <ui:VisualElement name="creature-card-img" class="creature-card-img" picking-mode="Ignore" />
                <ui:VisualElement class="creature-card-text" picking-mode="Ignore">
                    <ui:Label name="creature-card-sub" text="いきものを見つけた！" class="creature-card-sub" picking-mode="Ignore" />
                    <ui:Label name="creature-card-name" text="" class="creature-card-name" picking-mode="Ignore" />
                    <ui:Label name="creature-card-desc" text="" class="creature-card-desc" picking-mode="Ignore" />
                    <ui:Label text="図鑑に登録しました（タップで図鑑）" class="creature-card-note" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>


            <ui:VisualElement name="prompt" class="prompt" picking-mode="Ignore">
                <ui:Label name="prompt-key" text="Space" class="keycap" picking-mode="Ignore" />
                <ui:Label name="prompt-text" text="" class="prompt-text" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="help" class="hud-panel help" picking-mode="Ignore" />
            <ui:Label name="help-hint" text="H : 操作説明" class="help-hint" picking-mode="Ignore" />
            <ui:Label name="rotate-hint" text="スマホを横向きにすると遊びやすいよ" class="rotate-hint hidden" picking-mode="Ignore" />

            <ui:VisualElement name="touch" class="touch" picking-mode="Ignore">
                <ui:VisualElement name="move-zone" class="move-zone" />
                <ui:VisualElement name="joystick" class="joystick" picking-mode="Ignore">
                    <ui:VisualElement name="joystick-knob" class="joystick-knob" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="touch-buttons" picking-mode="Ignore">
                    <ui:VisualElement name="btn-dash" class="touch-button">
                        <ui:Label text="はやく" class="touch-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-aim" class="touch-button">
                        <ui:Label text="糸で" class="touch-label-top" picking-mode="Ignore" />
                        <ui:Label text="ねらう" class="touch-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-stand" class="touch-button">
                        <ui:Label text="背伸び" class="touch-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-silk" class="touch-button touch-button-big">
                        <ui:Label name="btn-silk-top" text="がけのふちで" class="touch-label-top" picking-mode="Ignore" />
                        <ui:Label name="btn-silk-label" text="糸" class="touch-label touch-label-big" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== タイトル（ウィンドウより下に置き、あそびかた・確認を上に重ねる） ===== -->
        <ui:VisualElement name="title-overlay" class="title-overlay hidden">
            <ui:VisualElement name="title-demo" class="title-demo" picking-mode="Ignore" />
            <ui:VisualElement class="title-vignette" picking-mode="Ignore" />
            <ui:VisualElement class="title-box" picking-mode="Ignore">
                <ui:Label text="しゃくとりの森" name="logo" class="logo" />
                <ui:Label text="— INCHWORM FOREST —" class="logo-sub" picking-mode="Ignore" />
                <ui:VisualElement class="title-buttons" picking-mode="Ignore">
                    <ui:Button name="btn-continue" text="つづきから" class="btn btn-primary btn-large" />
                    <ui:Button name="btn-new" text="はじめから" class="btn btn-large" />
                    <ui:Button name="btn-howto" text="あそびかた" class="btn" />
                    <ui:Button name="btn-credits" text="クレジット" class="btn btn-small-title" />
                </ui:VisualElement>
                <ui:Label name="title-progress" text="" class="title-progress" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label text="小さなしゃくとりむしになって、虫の目から見た大きな世界を、のんびり探検しよう。" class="title-hint" picking-mode="Ignore" />
            <ui:Label text="キーボード＆マウス / ゲームパッド / スマホ・タブレット 対応" class="title-hint title-hint-small" picking-mode="Ignore" />
            <ui:Label name="version" text="" class="version" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ===== 地図 ===== -->
        <ui:VisualElement name="map-overlay" class="overlay hidden">
            <ui:VisualElement class="window map-window">
                <ui:Label name="map-title" text="森の地図" class="window-title" picking-mode="Ignore" />
                <ui:VisualElement class="map-body" picking-mode="Ignore">
                    <ui:VisualElement name="bigmap" class="bigmap">
                        <ui:VisualElement name="bigmap-player" class="bigmap-player" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="map-side" picking-mode="Ignore">
                        <ui:Label name="map-summary" text="" class="map-summary" picking-mode="Ignore" />
                        <ui:ScrollView name="map-legend" class="map-legend" />
                        <ui:Label text="エリアの地図" class="map-areas-title" picking-mode="Ignore" />
                        <ui:VisualElement name="map-areas" class="map-areas" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="map-close" text="とじる" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== メニュー ===== -->
        <ui:VisualElement name="pause-overlay" class="overlay hidden">
            <ui:VisualElement class="window pause-window">
                <ui:Label text="メニュー" class="window-title" picking-mode="Ignore" />
                <ui:Label name="pause-summary" text="" class="pause-summary" picking-mode="Ignore" />
                <ui:Button name="resume" text="つづける" class="btn btn-primary" />
                <ui:Button name="tutorial-end" text="チュートリアルをおわって、森へ" class="btn hidden" />
                <ui:VisualElement class="row-buttons">
                    <ui:Button name="pause-howto" text="あそびかた" class="btn btn-small" />
                    <ui:Button name="pause-collection" text="図鑑・きせかえ" class="btn btn-small" />
                    <ui:Button name="save-now" text="いますぐセーブ" class="btn btn-small" />
                </ui:VisualElement>
                <ui:ScrollView name="settings-scroll" class="settings" horizontal-scroller-visibility="Hidden">
                    <ui:Label text="カメラと操作" class="settings-head" picking-mode="Ignore" />
                    <ui:Slider name="set-sens" label="カメラ感度" low-value="0.3" high-value="2.5" value="1" />
                    <ui:Slider name="set-fov" label="見える広さ" low-value="40" high-value="70" value="50" />
                    <ui:Toggle name="set-invert" label="カメラの上下を反転" />
                    <ui:Toggle name="set-invertx" label="カメラの左右を反転" />
                    <ui:Toggle name="set-autocam" label="カメラが自動で後ろへ回る" />
                    <ui:Toggle name="set-minimap" label="ミニマップを回転させる" />
                    <ui:Toggle name="set-sprinttoggle" label="「はやく」を押すたびに切りかえる" />
                    <ui:Toggle name="set-aimtoggle" label="「ねらう」を押すたびに切りかえる" />
                    <ui:Toggle name="set-wallup" label="壁では、スティックの上で登る" />
                    <ui:Toggle name="set-help" label="操作説明を表示する" />
                    <ui:Label text="音" class="settings-head" picking-mode="Ignore" />
                    <ui:Slider name="set-music" label="BGM の音量" low-value="0" high-value="1" value="0.55" />
                    <ui:Slider name="set-sfx" label="効果音の音量" low-value="0" high-value="1" value="0.8" />
                    <ui:Slider name="set-ambience" label="環境音の音量" low-value="0" high-value="1" value="0.8" />
                    <ui:Label text="表示と保存" class="settings-head" picking-mode="Ignore" />
                    <ui:VisualElement class="quality-row">
                        <ui:Label text="画質" class="quality-label" picking-mode="Ignore" />
                        <ui:Button name="q-low" text="かるい" class="chip" />
                        <ui:Button name="q-high" text="きれい" class="chip" />
                    </ui:VisualElement>
                    <ui:VisualElement class="quality-row">
                        <ui:Label text="文字の大きさ" class="quality-label" picking-mode="Ignore" />
                        <ui:Button name="t-normal" text="ふつう" class="chip" />
                        <ui:Button name="t-large" text="大きい" class="chip" />
                    </ui:VisualElement>
                    <ui:Toggle name="set-autosave" label="オートセーブ" />
                    <ui:Toggle name="set-motion" label="画面のゆれをへらす" />
                    <ui:Toggle name="set-vibrate" label="スマホをふるわせる" />
                    <ui:Toggle name="set-observe" label="しぐさの観察を知らせる" />
                    <ui:Button name="reset-settings" text="設定を最初にもどす" class="btn btn-small" />
                </ui:ScrollView>
                <ui:VisualElement class="row-buttons">
                    <ui:Button name="rescue" text="動けなくなったら" class="btn btn-small" />
                    <ui:Button name="photo" text="写真モード" class="btn btn-small" />
                    <ui:Button name="fullscreen" text="全画面" class="btn btn-small" />
                    <ui:Button name="to-title" text="タイトルへ" class="btn btn-small" />
                    <ui:Button name="reset" text="最初からやり直す" class="btn btn-small btn-danger" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== コレクション（図鑑・きせかえ・きろく）。メニューから開くので、メニューより前面に置く ===== -->
        <ui:VisualElement name="collection-overlay" class="overlay hidden">
            <ui:VisualElement class="window collection-window">
                <ui:VisualElement class="tabs">
                    <ui:Button name="tab-zukan" text="いきもの図鑑" class="tab tab--on" />
                    <ui:Button name="tab-skin" text="きせかえ" class="tab" />
                    <ui:Button name="tab-record" text="きろく" class="tab" />
                </ui:VisualElement>
                <ui:VisualElement name="page-zukan" class="page">
                    <ui:VisualElement class="zukan-body">
                        <ui:ScrollView name="zukan-grid" class="zukan-grid" horizontal-scroller-visibility="Hidden" />
                        <ui:ScrollView name="zukan-detail" class="zukan-detail" mode="Vertical" horizontal-scroller-visibility="Hidden">
                            <ui:VisualElement name="zukan-img" class="zukan-img" picking-mode="Ignore" />
                            <ui:VisualElement class="zukan-text" picking-mode="Ignore">
                                <ui:Label name="zukan-name" text="" class="zukan-name" picking-mode="Ignore" />
                                <ui:Label name="zukan-area" text="" class="zukan-area" picking-mode="Ignore" />
                                <ui:VisualElement name="zukan-go" class="zukan-go" />
                                <ui:Label name="zukan-desc" text="" class="zukan-desc" picking-mode="Ignore" />
                                <ui:VisualElement name="zukan-friend" class="zukan-friend" picking-mode="Ignore" />
                                <ui:Label name="zukan-habitat-title" text="" class="zukan-habitat-title" picking-mode="Ignore" />
                                <ui:VisualElement name="zukan-habitat" class="zukan-habitat" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="page-skin" class="page hidden">
                    <ui:Label text="集めた数で、いろ・ぼうし・めがねがふえていきます。いろとぼうしとめがねは、いっしょに身につけられます。" class="page-sub" picking-mode="Ignore" />
                    <ui:ScrollView name="skin-scroll" class="skin-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" mouse-wheel-scroll-size="90">
                        <ui:VisualElement name="skin-grid" class="skin-grid" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="page-record" class="page hidden">
                    <ui:ScrollView name="record-list" class="record-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                </ui:VisualElement>
                <ui:Button name="collection-close" text="とじる" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== あそびかた ===== -->
        <ui:VisualElement name="howto-overlay" class="overlay hidden">
            <ui:VisualElement class="window howto-window">
                <ui:Label text="あそびかた" class="window-title" picking-mode="Ignore" />
                <ui:Label class="howto-lead" text="あなたは小さなしゃくとりむし。体を「Ω」の字に曲げては伸ばして、少しずつ進みます。&#10;森のしずくを集め、名所をめぐり、いろんないきものに会いに行こう。戦いはありません。" picking-mode="Ignore" />
                <ui:ScrollView name="howto-grid" class="howto-grid" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                <ui:Label class="howto-tip" text="ヒント：森のはしのトンネルを抜けると、となりの場所へ行けます。その先にも、まだ知らない場所が。いきものに近づくと図鑑に登録され、しずく・名所・いきものを集めるほど、きせかえが増えます。" picking-mode="Ignore" />
                <ui:Button name="howto-close" text="わかった！" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== 確認 ===== -->
        <ui:VisualElement name="confirm-overlay" class="overlay hidden">
            <ui:VisualElement class="window confirm-window">
                <ui:Label name="confirm-text" text="" class="confirm-text" picking-mode="Ignore" />
                <ui:VisualElement class="row-buttons">
                    <ui:Button name="confirm-no" text="やめる" class="btn btn-small" />
                    <ui:Button name="confirm-yes" text="はい" class="btn btn-small btn-danger" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== はじめから：練習（チュートリアル）をするか ===== -->
        <ui:VisualElement name="tutorial-overlay" class="overlay hidden">
            <ui:VisualElement class="window tutorial-window">
                <ui:Label text="チュートリアル" class="window-title" picking-mode="Ignore" />
                <ui:Label text="はじめに、うごかし方を練習しますか？" class="confirm-text" picking-mode="Ignore" />
                <ui:Label text="練習用の小さな森で、すすむ・登る・糸でおりる・糸をねらう などを、ひとつずつ ためせます（5 分くらい）。練習のあとは、そのまま森から始まります。" class="tutorial-lead" picking-mode="Ignore" />
                <ui:Button name="tutorial-yes" text="練習してから はじめる" class="btn btn-primary" />
                <ui:Button name="tutorial-no" text="練習しないで はじめる" class="btn" />
                <ui:Button name="tutorial-back" text="もどる" class="btn btn-small" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== クレジット ===== -->
        <ui:VisualElement name="credits-overlay" class="overlay hidden">
            <ui:VisualElement class="window credits-window">
                <ui:Label text="クレジット" class="window-title" picking-mode="Ignore" />
                <ui:Label name="credits-text" text="" class="credits-text" picking-mode="Ignore" />
                <ui:Button name="credits-close" text="とじる" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="photo-hint" text="写真モード（F2 / 画面をタップでもどる）" class="photo-hint hidden" picking-mode="Ignore" />

        <!-- ===== クリア ===== -->
        <ui:VisualElement name="complete-overlay" class="overlay hidden">
            <ui:VisualElement class="window complete-window">
                <ui:Label name="complete-title" text="森をめぐり終えました！" class="window-title complete-title" picking-mode="Ignore" />
                <ui:Label name="complete-text" text="" class="complete-text" picking-mode="Ignore" />
                <ui:Button name="complete-close" text="このまま散歩をつづける" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 通知（ウィンドウの上にも出す） -->
        <ui:VisualElement name="toasts" class="toasts" picking-mode="Ignore" />

        <!-- ===== 読み込み ===== -->
        <ui:VisualElement name="loading" class="loading">
            <ui:Label text="しゃくとりの森" class="loading-logo" picking-mode="Ignore" />
            <ui:VisualElement class="loading-bar" picking-mode="Ignore">
                <ui:VisualElement name="loading-fill" class="loading-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="loading-tip" text="" class="loading-tip" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
