<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="GameUI.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement name="look-area" class="look-area" />

        <!-- ===== HUD ===== -->
        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:VisualElement name="objectives" class="hud-panel objectives" picking-mode="Ignore">
                <ui:VisualElement class="obj-row" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon-drop" picking-mode="Ignore" />
                    <ui:Label text="森のしずく" class="obj-label" picking-mode="Ignore" />
                    <ui:Label name="drop-count" text="0 / 45" class="obj-count" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="obj-row" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon-place" picking-mode="Ignore" />
                    <ui:Label text="名所" class="obj-label" picking-mode="Ignore" />
                    <ui:Label name="place-count" text="0 / 9" class="obj-count" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="area-name" text="" class="area-name" picking-mode="Ignore" />

            <ui:VisualElement name="top-right" class="top-right" picking-mode="Ignore">
                <ui:VisualElement name="minimap" class="minimap">
                    <ui:VisualElement name="minimap-mask" class="minimap-mask" picking-mode="Ignore">
                        <ui:VisualElement name="minimap-image" class="minimap-image" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="minimap-player" class="minimap-player" picking-mode="Ignore" />
                    <ui:Label text="N" class="minimap-north" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="top-buttons" picking-mode="Ignore">
                    <ui:Button name="map-button" class="round-button">
                        <ui:VisualElement class="icon icon-map" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="menu-button" class="round-button">
                        <ui:VisualElement class="icon icon-menu" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="banner" class="banner" picking-mode="Ignore">
                <ui:VisualElement class="banner-deco" picking-mode="Ignore" />
                <ui:Label name="banner-sub" text="新たな場所を発見" class="banner-sub" picking-mode="Ignore" />
                <ui:Label name="banner-title" text="" class="banner-title" picking-mode="Ignore" />
                <ui:Label name="banner-desc" text="" class="banner-desc" picking-mode="Ignore" />
                <ui:VisualElement class="banner-deco banner-deco-bottom" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="toasts" class="toasts" picking-mode="Ignore" />

            <ui:VisualElement name="prompt" class="prompt" picking-mode="Ignore">
                <ui:Label name="prompt-key" text="Space" class="keycap" picking-mode="Ignore" />
                <ui:Label name="prompt-text" text="" class="prompt-text" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="help" class="hud-panel help" picking-mode="Ignore" />
            <ui:Label name="help-hint" text="H : 操作説明" class="help-hint" picking-mode="Ignore" />

            <ui:VisualElement name="touch" class="touch" picking-mode="Ignore">
                <ui:VisualElement name="joystick" class="joystick">
                    <ui:VisualElement name="joystick-knob" class="joystick-knob" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="touch-buttons" picking-mode="Ignore">
                    <ui:VisualElement name="btn-dash" class="touch-button">
                        <ui:Label text="はやく" class="touch-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-stand" class="touch-button">
                        <ui:Label text="背伸び" class="touch-label" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-silk" class="touch-button touch-button-big">
                        <ui:Label text="糸" class="touch-label touch-label-big" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== 地図 ===== -->
        <ui:VisualElement name="map-overlay" class="overlay hidden">
            <ui:VisualElement class="window map-window">
                <ui:Label text="森の地図" class="window-title" picking-mode="Ignore" />
                <ui:VisualElement class="map-body" picking-mode="Ignore">
                    <ui:VisualElement name="bigmap" class="bigmap" picking-mode="Ignore">
                        <ui:VisualElement name="bigmap-player" class="bigmap-player" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="map-side" picking-mode="Ignore">
                        <ui:Label name="map-summary" text="" class="map-summary" picking-mode="Ignore" />
                        <ui:ScrollView name="map-legend" class="map-legend" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="map-close" text="とじる" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== メニュー ===== -->
        <ui:VisualElement name="pause-overlay" class="overlay hidden">
            <ui:VisualElement class="window pause-window">
                <ui:Label text="メニュー" class="window-title" picking-mode="Ignore" />
                <ui:Button name="resume" text="つづける" class="btn btn-primary" />
                <ui:Button name="pause-howto" text="あそびかた" class="btn" />
                <ui:VisualElement class="settings">
                    <ui:Slider name="set-sens" label="カメラ感度" low-value="0.3" high-value="2.5" value="1" />
                    <ui:Toggle name="set-invert" label="カメラの上下を反転" />
                    <ui:Slider name="set-music" label="BGM の音量" low-value="0" high-value="1" value="0.55" />
                    <ui:Slider name="set-sfx" label="効果音・環境音" low-value="0" high-value="1" value="0.8" />
                    <ui:VisualElement class="quality-row">
                        <ui:Label text="画質" class="quality-label" picking-mode="Ignore" />
                        <ui:Button name="q-low" text="かるい" class="chip" />
                        <ui:Button name="q-high" text="きれい" class="chip" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="row-buttons">
                    <ui:Button name="to-title" text="タイトルへ" class="btn btn-small" />
                    <ui:Button name="reset" text="最初からやり直す" class="btn btn-small btn-danger" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== あそびかた ===== -->
        <ui:VisualElement name="howto-overlay" class="overlay hidden">
            <ui:VisualElement class="window howto-window">
                <ui:Label text="あそびかた" class="window-title" picking-mode="Ignore" />
                <ui:Label class="howto-lead" text="あなたは小さなしゃくとりむし。体を「Ω」の字に曲げては伸ばして、少しずつ進みます。&#10;森のどこかにある「森のしずく」を集め、9つの名所を見つけよう。戦いはありません。" picking-mode="Ignore" />
                <ui:VisualElement name="howto-grid" class="howto-grid" picking-mode="Ignore" />
                <ui:Label class="howto-tip" text="ヒント：キノコの柄や切り株の壁も、しゃくとりむしなら登れます。高い所からは糸を出して下りられます。" picking-mode="Ignore" />
                <ui:Button name="howto-close" text="わかった！" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== 確認 ===== -->
        <ui:VisualElement name="confirm-overlay" class="overlay hidden">
            <ui:VisualElement class="window confirm-window">
                <ui:Label name="confirm-text" text="" class="confirm-text" picking-mode="Ignore" />
                <ui:VisualElement class="row-buttons">
                    <ui:Button name="confirm-no" text="やめる" class="btn btn-small" />
                    <ui:Button name="confirm-yes" text="はい" class="btn btn-small btn-danger" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== クリア ===== -->
        <ui:VisualElement name="complete-overlay" class="overlay hidden">
            <ui:VisualElement class="window complete-window">
                <ui:Label text="森をめぐり終えました！" class="window-title complete-title" picking-mode="Ignore" />
                <ui:Label name="complete-text" text="" class="complete-text" picking-mode="Ignore" />
                <ui:Button name="complete-close" text="このまま森を散歩する" class="btn btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== タイトル ===== -->
        <ui:VisualElement name="title-overlay" class="title-overlay hidden">
            <ui:VisualElement class="title-vignette" picking-mode="Ignore" />
            <ui:VisualElement class="title-box" picking-mode="Ignore">
                <ui:Label text="しゃくとりの森" name="logo" class="logo" picking-mode="Ignore" />
                <ui:Label text="— INCHWORM FOREST —" class="logo-sub" picking-mode="Ignore" />
                <ui:VisualElement class="title-buttons" picking-mode="Ignore">
                    <ui:Button name="btn-continue" text="つづきから" class="btn btn-primary btn-large" />
                    <ui:Button name="btn-new" text="はじめる" class="btn btn-large" />
                    <ui:Button name="btn-howto" text="あそびかた" class="btn" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="小さなしゃくとりむしになって、森をのんびり探検しよう。" class="title-hint" picking-mode="Ignore" />
            <ui:Label text="キーボード＆マウス / ゲームパッド / タッチ 対応" class="title-hint title-hint-small" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ===== 読み込み ===== -->
        <ui:VisualElement name="loading" class="loading">
            <ui:Label text="しゃくとりの森" class="loading-logo" picking-mode="Ignore" />
            <ui:VisualElement class="loading-bar" picking-mode="Ignore">
                <ui:VisualElement name="loading-fill" class="loading-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="loading-text" text="森を準備しています" class="loading-text" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
