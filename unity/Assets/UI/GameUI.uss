/* しゃくとりの森 UI — やわらかいクリーム色と金のアクセント */

.root {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 22px;
}

.hidden {
    display: none;
}

.look-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.hud--hidden {
    opacity: 0;
}

.icon {
    width: 30px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.icon-drop { background-image: url("Icons/icon_drop.png"); }
.icon-place { background-image: url("Icons/icon_place.png"); }
.icon-map { background-image: url("Icons/icon_map.png"); width: 34px; height: 34px; }
.icon-menu { background-image: url("Icons/icon_menu.png"); width: 34px; height: 34px; }

.hud-panel {
    background-color: rgba(28, 40, 34, 0.42);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
    padding: 10px 18px;
}

/* ---- 目標 ---- */
.objectives {
    position: absolute;
    left: 28px;
    top: 24px;
    min-width: 270px;
}

.obj-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
}

.obj-label {
    margin-left: 10px;
    flex-grow: 1;
    font-size: 21px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
}

.obj-count {
    font-size: 23px;
    -unity-font-style: bold;
    margin-left: 18px;
    color: rgb(255, 238, 190);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    transition-property: scale, color;
    transition-duration: 0.25s;
}

.obj-count--pop {
    scale: 1.35 1.35;
    color: rgb(170, 245, 255);
}

.area-name {
    position: absolute;
    left: 32px;
    top: 128px;
    font-size: 20px;
    color: rgb(255, 246, 220);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    opacity: 0.95;
    transition-property: opacity;
    transition-duration: 0.6s;
}

/* ---- ミニマップ ---- */
.top-right {
    position: absolute;
    right: 28px;
    top: 22px;
    flex-direction: row;
    align-items: flex-start;
}

.minimap {
    width: 220px;
    height: 220px;
    border-radius: 110px;
    border-width: 4px;
    border-color: rgba(255, 244, 214, 0.9);
    background-color: rgba(20, 30, 25, 0.6);
}

.minimap-mask {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 106px;
    overflow: hidden;
}

.minimap-image {
    position: absolute;
    width: 440px;
    height: 440px;
    -unity-background-scale-mode: stretch-to-fill;
}

.minimap-player {
    position: absolute;
    width: 30px;
    height: 30px;
    left: 91px;
    top: 91px;
    background-image: url("Icons/icon_player.png");
    -unity-background-scale-mode: scale-to-fit;
}

.minimap-north {
    position: absolute;
    left: 96px;
    top: -14px;
    width: 20px;
    height: 24px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(120, 70, 40);
    background-color: rgb(255, 244, 214);
    border-radius: 8px;
}

.map-marker {
    position: absolute;
    width: 26px;
    height: 26px;
    -unity-background-scale-mode: scale-to-fit;
}

.map-marker--place { background-image: url("Icons/icon_place.png"); }
.map-marker--unknown { background-image: url("Icons/icon_unknown.png"); }

.map-dot {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: rgb(150, 235, 255);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.9);
}

.top-buttons {
    flex-direction: column;
    margin-left: 12px;
}

.round-button {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    margin: 0 0 10px 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(28, 40, 34, 0.5);
    border-width: 2px;
    border-color: rgba(255, 244, 214, 0.75);
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.round-button:hover {
    background-color: rgba(60, 80, 66, 0.75);
    scale: 1.06 1.06;
}

.round-button:active {
    scale: 0.94 0.94;
}

/* ---- 発見バナー ---- */
.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 150px;
    align-items: center;
    opacity: 0;
    translate: 0 -16px;
    transition-property: opacity, translate;
    transition-duration: 0.8s;
}

.banner--show {
    opacity: 1;
    translate: 0 0;
}

.banner-deco {
    width: 520px;
    height: 22px;
    background-image: url("Icons/banner_deco.png");
    -unity-background-scale-mode: scale-to-fit;
}

.banner-deco-bottom {
    rotate: 180deg;
    margin-top: 6px;
}

.banner-sub {
    font-size: 20px;
    color: rgb(255, 236, 180);
    letter-spacing: 6px;
    margin-top: 6px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
}

.banner-title {
    font-size: 64px;
    color: rgb(255, 255, 255);
    letter-spacing: 6px;
    -unity-font-style: bold;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.55);
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(90, 60, 30, 0.6);
}

.banner-desc {
    font-size: 22px;
    color: rgb(250, 248, 240);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.7);
    margin-top: 2px;
}

/* ---- トースト ---- */
.toasts {
    position: absolute;
    right: 32px;
    top: 330px;
    align-items: flex-end;
}

.toast {
    flex-direction: row;
    align-items: center;
    background-color: rgba(28, 40, 34, 0.55);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(170, 240, 255, 0.6);
    padding: 6px 16px;
    margin-bottom: 8px;
    opacity: 0;
    translate: 40px 0;
    transition-property: opacity, translate;
    transition-duration: 0.35s;
}

.toast--show {
    opacity: 1;
    translate: 0 0;
}

.toast-label {
    margin-left: 8px;
    font-size: 21px;
    color: rgb(225, 250, 255);
}

/* ---- 操作のヒント ---- */
.prompt {
    position: absolute;
    bottom: 120px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.prompt--show {
    opacity: 1;
}

.keycap {
    background-color: rgb(255, 248, 230);
    color: rgb(80, 60, 40);
    border-radius: 8px;
    border-bottom-width: 3px;
    border-color: rgb(200, 175, 125);
    padding: 3px 12px;
    font-size: 20px;
    -unity-font-style: bold;
    margin-right: 10px;
}

.prompt-text {
    font-size: 23px;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.7);
}

.help {
    position: absolute;
    left: 28px;
    bottom: 26px;
    transition-property: opacity, translate;
    transition-duration: 0.4s;
}

.help--hidden {
    opacity: 0;
    translate: -30px 0;
}

.help-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
}

.help-key {
    min-width: 128px;
    flex-direction: row;
}

.help-key .keycap {
    font-size: 16px;
    padding: 1px 8px;
    margin-right: 4px;
}

.help-text {
    font-size: 18px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
}

.help-hint {
    position: absolute;
    left: 30px;
    bottom: 22px;
    font-size: 16px;
    opacity: 0.75;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
}

/* ---- タッチ ---- */
.touch {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.joystick {
    position: absolute;
    left: 70px;
    bottom: 60px;
    width: 230px;
    height: 230px;
    border-radius: 115px;
    background-color: rgba(255, 255, 255, 0.14);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.45);
}

.joystick-knob {
    position: absolute;
    left: 70px;
    top: 70px;
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background-color: rgba(255, 250, 235, 0.85);
    border-width: 2px;
    border-color: rgba(200, 175, 125, 0.9);
}

.touch-buttons {
    position: absolute;
    right: 60px;
    bottom: 60px;
    flex-direction: row;
    align-items: flex-end;
}

.touch-button {
    width: 112px;
    height: 112px;
    border-radius: 56px;
    margin-left: 18px;
    background-color: rgba(28, 40, 34, 0.5);
    border-width: 3px;
    border-color: rgba(255, 244, 214, 0.8);
    align-items: center;
    justify-content: center;
}

.touch-button--on {
    background-color: rgba(240, 200, 105, 0.85);
}

.touch-button-big {
    width: 150px;
    height: 150px;
    border-radius: 75px;
}

.touch-label {
    font-size: 22px;
    -unity-font-style: bold;
}

.touch-label-big {
    font-size: 40px;
}

/* ---- ウィンドウ共通 ---- */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 18, 14, 0.55);
    align-items: center;
    justify-content: center;
}

.window {
    background-color: rgba(252, 248, 238, 0.97);
    border-radius: 24px;
    border-width: 3px;
    border-color: rgb(214, 186, 128);
    padding: 26px 40px 30px 40px;
    align-items: stretch;
    color: rgb(74, 62, 50);
    min-width: 520px;
}

.window-title {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(110, 82, 50);
    margin-bottom: 16px;
    letter-spacing: 4px;
}

.btn {
    height: 56px;
    margin: 6px 0;
    border-radius: 28px;
    border-width: 2px;
    border-color: rgb(214, 186, 128);
    background-color: rgb(246, 238, 220);
    color: rgb(90, 70, 50);
    font-size: 23px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.btn:hover {
    background-color: rgb(255, 248, 232);
    scale: 1.03 1.03;
}

.btn:active {
    scale: 0.97 0.97;
}

.btn:focus {
    border-color: rgb(120, 190, 120);
}

.btn-primary {
    background-color: rgb(244, 205, 110);
    border-color: rgb(196, 152, 70);
    color: rgb(70, 50, 20);
}

.btn-primary:hover {
    background-color: rgb(252, 218, 132);
}

.btn-danger {
    color: rgb(170, 70, 60);
}

.btn-large {
    height: 66px;
    font-size: 27px;
    width: 320px;
}

.btn-small {
    flex-grow: 1;
    height: 48px;
    font-size: 19px;
    margin: 6px 6px;
}

.row-buttons {
    flex-direction: row;
    margin-top: 10px;
}

.settings {
    margin: 12px 0 4px 0;
    padding: 12px 16px;
    border-radius: 14px;
    background-color: rgba(220, 200, 160, 0.22);
}

.settings .unity-label {
    color: rgb(90, 70, 50);
    font-size: 19px;
    min-width: 190px;
}

.settings .unity-base-slider__tracker {
    background-color: rgb(225, 210, 180);
    border-color: rgb(200, 180, 140);
}

.settings .unity-base-slider__dragger {
    background-color: rgb(244, 205, 110);
    border-color: rgb(196, 152, 70);
}

.quality-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.quality-label {
    min-width: 190px;
    font-size: 19px;
    color: rgb(90, 70, 50);
}

.chip {
    height: 40px;
    min-width: 110px;
    border-radius: 20px;
    border-width: 2px;
    border-color: rgb(214, 186, 128);
    background-color: rgb(246, 238, 220);
    color: rgb(90, 70, 50);
    font-size: 18px;
    margin-right: 8px;
}

.chip--on {
    background-color: rgb(244, 205, 110);
    border-color: rgb(196, 152, 70);
}

/* ---- 地図 ---- */
.map-window {
    width: 1160px;
}

.map-body {
    flex-direction: row;
    margin-bottom: 14px;
}

.bigmap {
    width: 620px;
    height: 620px;
    border-radius: 18px;
    border-width: 3px;
    border-color: rgb(214, 186, 128);
    overflow: hidden;
    -unity-background-scale-mode: stretch-to-fill;
}

.bigmap-player {
    position: absolute;
    width: 36px;
    height: 36px;
    background-image: url("Icons/icon_player.png");
    -unity-background-scale-mode: scale-to-fit;
}

.bigmap-label {
    position: absolute;
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
    -unity-text-align: middle-center;
    width: 200px;
}

.map-side {
    flex-grow: 1;
    margin-left: 24px;
}

.map-summary {
    font-size: 20px;
    color: rgb(110, 82, 50);
    margin-bottom: 10px;
    white-space: normal;
}

.map-legend {
    flex-grow: 1;
}

.legend-row {
    flex-direction: row;
    align-items: center;
    padding: 7px 10px;
    margin-bottom: 4px;
    border-radius: 12px;
    background-color: rgba(220, 200, 160, 0.22);
}

.legend-name {
    font-size: 20px;
    margin-left: 10px;
    color: rgb(80, 64, 48);
    -unity-font-style: bold;
}

.legend-name--unknown {
    color: rgb(160, 145, 125);
}

.legend-desc {
    font-size: 15px;
    color: rgb(130, 112, 92);
    white-space: normal;
    margin-left: 10px;
}

/* ---- あそびかた ---- */
.howto-window {
    width: 900px;
}

.howto-lead {
    font-size: 20px;
    white-space: normal;
    margin-bottom: 14px;
    color: rgb(90, 74, 58);
}

.howto-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.howto-item {
    width: 50%;
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
}

.howto-item .keycap {
    background-color: rgb(238, 226, 200);
    font-size: 17px;
    margin-right: 6px;
}

.howto-item-text {
    font-size: 19px;
    margin-left: 8px;
    color: rgb(80, 64, 48);
}

.howto-tip {
    font-size: 17px;
    white-space: normal;
    color: rgb(120, 140, 90);
    margin: 6px 0 12px 0;
}

.confirm-window {
    width: 560px;
}

.confirm-text {
    font-size: 22px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 10px 0 16px 0;
}

.complete-window {
    width: 640px;
}

.complete-title {
    color: rgb(190, 130, 40);
}

.complete-text {
    font-size: 21px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

/* ---- タイトル ---- */
.title-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.8s;
}

.title-overlay--out {
    opacity: 0;
}

.title-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("Icons/vignette.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.title-box {
    align-items: center;
    margin-top: -40px;
}

.logo {
    font-size: 118px;
    color: rgb(255, 253, 244);
    letter-spacing: 10px;
    text-shadow: 0 6px 18px rgba(30, 50, 20, 0.6);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(70, 110, 50, 0.55);
}

.logo-sub {
    font-size: 24px;
    letter-spacing: 12px;
    color: rgb(255, 238, 190);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    margin-bottom: 40px;
}

.title-buttons {
    align-items: center;
}

.title-buttons .btn {
    width: 320px;
}

.title-hint {
    position: absolute;
    bottom: 64px;
    font-size: 21px;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.75);
}

.title-hint-small {
    bottom: 30px;
    font-size: 16px;
    opacity: 0.8;
}

/* ---- 読み込み ---- */
.loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(38, 58, 40);
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.8s;
}

.loading--out {
    opacity: 0;
}

.loading-logo {
    font-size: 72px;
    letter-spacing: 8px;
    color: rgb(240, 248, 225);
    margin-bottom: 30px;
}

.loading-bar {
    width: 480px;
    height: 12px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.15);
    overflow: hidden;
}

.loading-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(170, 220, 110);
    border-radius: 6px;
}

.loading-text {
    margin-top: 16px;
    font-size: 20px;
    color: rgb(210, 230, 200);
}

.fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.fade--on {
    opacity: 1;
}

/* ===================================================================
   追加：エリア・いきもの図鑑・きせかえ・スマホ対応
   =================================================================== */

.icon-bug { background-image: url("Icons/icon_bug.png"); }
.icon-book { background-image: url("Icons/icon_book.png"); width: 34px; height: 34px; }
.icon-fullscreen { background-image: url("Icons/icon_fullscreen.png"); width: 30px; height: 30px; }
.icon-lock { background-image: url("Icons/icon_lock.png"); }
.map-marker--gate { background-image: url("Icons/icon_gate.png"); }

.area-title {
    font-size: 15px;
    letter-spacing: 4px;
    color: rgb(255, 232, 170);
    margin-bottom: 2px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
}

.area-name {
    top: 246px;
}

/* ---- いきもの発見カード ---- */
.creature-card {
    position: absolute;
    right: 28px;
    bottom: 140px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(252, 248, 238, 0.95);
    border-radius: 20px;
    border-width: 3px;
    border-color: rgb(214, 186, 128);
    padding: 10px 18px 10px 10px;
    width: 470px;
    opacity: 0;
    translate: 60px 0;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
}

.creature-card--show {
    opacity: 1;
    translate: 0 0;
}

.creature-card-img {
    width: 120px;
    height: 120px;
    border-radius: 16px;
    background-color: rgba(220, 230, 200, 0.6);
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.creature-card-text {
    flex-shrink: 1;
    margin-left: 14px;
}

.creature-card-sub {
    font-size: 16px;
    color: rgb(190, 130, 40);
    letter-spacing: 2px;
}

.creature-card-name {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(74, 62, 50);
}

.creature-card-desc {
    font-size: 15px;
    white-space: normal;
    color: rgb(110, 94, 76);
}

.creature-card-note {
    font-size: 13px;
    color: rgb(120, 160, 90);
    margin-top: 4px;
}

/* ---- 地図：エリア移動 ---- */
.map-areas-title {
    font-size: 18px;
    color: rgb(110, 82, 50);
    margin-top: 12px;
    -unity-font-style: bold;
}

.map-areas {
    flex-direction: row;
    margin-top: 6px;
}

.area-chip {
    flex-grow: 1;
    height: 52px;
    margin-right: 8px;
    border-radius: 26px;
    border-width: 2px;
    border-color: rgb(214, 186, 128);
    background-color: rgb(246, 238, 220);
    color: rgb(90, 70, 50);
    font-size: 19px;
    -unity-font-style: bold;
}

.area-chip--here {
    background-color: rgb(196, 226, 150);
    border-color: rgb(120, 170, 80);
}

.area-chip--locked {
    color: rgb(170, 155, 135);
}

/* ---- コレクション ---- */
.collection-window {
    width: 1180px;
    height: 820px;
}

.tabs {
    flex-direction: row;
    margin-bottom: 12px;
}

.tab {
    flex-grow: 1;
    height: 54px;
    margin-right: 8px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(214, 186, 128);
    background-color: rgb(246, 238, 220);
    color: rgb(120, 96, 70);
    font-size: 21px;
    -unity-font-style: bold;
}

.tab--on {
    background-color: rgb(244, 205, 110);
    color: rgb(70, 50, 20);
    border-color: rgb(196, 152, 70);
}

.page {
    flex-grow: 1;
    flex-shrink: 1;
}

.page-sub {
    font-size: 18px;
    color: rgb(120, 100, 76);
    margin-bottom: 8px;
    white-space: normal;
}

.zukan-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.zukan-grid {
    flex-grow: 1;
    flex-shrink: 1;
}

.zukan-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.zukan-card {
    width: 150px;
    height: 176px;
    margin: 5px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(225, 205, 160);
    background-color: rgb(250, 244, 230);
    align-items: center;
    padding: 6px;
}

.zukan-card:hover {
    border-color: rgb(196, 152, 70);
}

.zukan-card--selected {
    border-color: rgb(120, 170, 80);
    background-color: rgb(236, 246, 220);
}

.zukan-card-img {
    width: 120px;
    height: 120px;
    -unity-background-scale-mode: scale-to-fit;
}

.zukan-card-img--unknown {
    -unity-background-image-tint-color: rgba(60, 50, 40, 0.85);
}

.zukan-card-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(80, 64, 48);
    -unity-text-align: middle-center;
}

.zukan-detail {
    width: 330px;
    flex-shrink: 0;
    margin-left: 14px;
    padding: 14px;
    border-radius: 18px;
    background-color: rgba(220, 200, 160, 0.25);
    align-items: center;
}

.zukan-img {
    width: 240px;
    height: 240px;
    -unity-background-scale-mode: scale-to-fit;
}

.zukan-name {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(74, 62, 50);
    margin-top: 6px;
}

.zukan-area {
    font-size: 16px;
    color: rgb(140, 120, 90);
    margin-bottom: 8px;
}

.zukan-desc {
    font-size: 18px;
    white-space: normal;
    color: rgb(90, 74, 58);
}

.skin-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.skin-card {
    width: 250px;
    height: 150px;
    margin: 6px;
    border-radius: 18px;
    border-width: 3px;
    border-color: rgb(225, 205, 160);
    background-color: rgb(250, 244, 230);
    flex-direction: row;
    align-items: center;
    padding: 10px;
}

.skin-card--on {
    border-color: rgb(120, 170, 80);
    background-color: rgb(236, 246, 220);
}

.skin-card--locked {
    opacity: 0.6;
}

.skin-swatch {
    width: 74px;
    height: 74px;
    border-radius: 37px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    flex-shrink: 0;
}

.skin-text {
    margin-left: 12px;
    flex-shrink: 1;
}

.skin-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(74, 62, 50);
}

.skin-cond {
    font-size: 14px;
    color: rgb(130, 112, 92);
    white-space: normal;
}

.record-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 12px 16px;
    margin-bottom: 6px;
    border-radius: 14px;
    background-color: rgba(220, 200, 160, 0.22);
}

.record-label {
    font-size: 21px;
    color: rgb(80, 64, 48);
}

.record-value {
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(110, 82, 50);
}

/* ---- スマホ・タブレット ---- */
.touch-only {
    display: none;
}

.touch-ui .touch-only {
    display: flex;
}

.move-zone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 46%;
    height: 78%;
}

.joystick {
    opacity: 0.45;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.joystick--active {
    opacity: 1;
}

.touch-ui .round-button {
    width: 72px;
    height: 72px;
    border-radius: 36px;
}

.touch-ui .btn {
    height: 66px;
}

.touch-ui .help {
    bottom: auto;
    top: 290px;
}

.rotate-hint {
    position: absolute;
    top: 46%;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 26px;
    color: rgb(255, 250, 235);
    background-color: rgba(28, 40, 34, 0.6);
    padding: 14px 0;
}

.zukan-text {
    align-items: center;
    flex-shrink: 1;
}

.touch-ui .prompt {
    bottom: 236px;
}

.touch-ui .help-hint {
    display: none;
}

/* ===================================================================
   画面の形に合わせたレイアウト
   .short    : 横長で背が低い（横向きのスマホ）
   .portrait : 縦長（縦向きのスマホ・タブレット）
   .compact  : どちらか
   =================================================================== */
.compact .window {
    min-width: 0;
}

.compact .minimap {
    width: 170px;
    height: 170px;
    border-radius: 85px;
}

.compact .minimap-mask {
    border-radius: 81px;
}

.compact .minimap-player {
    left: 66px;
    top: 66px;
}

.compact .minimap-north {
    left: 71px;
}

.compact .objectives {
    left: 14px;
    top: 12px;
    min-width: 0;
    padding: 6px 14px;
}

.compact .obj-row {
    padding: 2px 0;
}

.compact .obj-label {
    font-size: 18px;
}

.compact .obj-count {
    font-size: 20px;
    margin-left: 12px;
}

.compact .area-name {
    left: 18px;
    top: 186px;
    font-size: 18px;
}

.compact .top-right {
    right: 14px;
    top: 12px;
}

.compact .round-button {
    margin-bottom: 8px;
}

.compact .banner-title {
    font-size: 44px;
}

.compact .banner-deco {
    width: 360px;
}

.compact .banner-desc {
    font-size: 18px;
}

.compact .creature-card-img {
    width: 88px;
    height: 88px;
}

.compact .creature-card-name {
    font-size: 24px;
}

.compact .logo {
    font-size: 80px;
}

.compact .logo-sub {
    margin-bottom: 18px;
    letter-spacing: 6px;
}

.compact .title-hint {
    bottom: 40px;
    font-size: 17px;
}

.compact .title-hint-small {
    bottom: 14px;
    font-size: 14px;
}

.compact .loading-logo {
    font-size: 54px;
}

.compact .loading-bar {
    width: 360px;
}

.compact .skin-card {
    width: 46%;
    height: 120px;
}

.compact .skin-swatch {
    width: 60px;
    height: 60px;
    border-radius: 30px;
}

.compact .zukan-card {
    width: 124px;
    height: 150px;
}

.compact .zukan-card-img {
    width: 96px;
    height: 96px;
}

/* ---- 横向きのスマホ（背が低い） ---- */
.short .window {
    padding: 12px 24px 14px 24px;
}

.short .window-title {
    font-size: 28px;
    margin-bottom: 6px;
}

.short .btn {
    height: 50px;
    margin: 4px 0;
}

.short .btn-small {
    height: 46px;
    margin: 4px 6px;
}

.short .btn-large {
    height: 56px;
}

.short .row-buttons {
    margin-top: 4px;
}

.short .settings {
    margin: 6px 0 2px 0;
    padding: 6px 14px;
}

.short .map-window {
    width: 96%;
}

.short .bigmap {
    width: 430px;
    height: 430px;
}

.short .map-body {
    margin-bottom: 6px;
}

.short .area-chip {
    height: 46px;
    font-size: 17px;
}

.short .collection-window {
    width: 96%;
    height: 96%;
}

.short .tab {
    height: 46px;
    font-size: 19px;
}

.short .tabs {
    margin-bottom: 6px;
}

.short .zukan-detail {
    width: 280px;
    padding: 8px;
}

.short .zukan-img {
    width: 150px;
    height: 150px;
}

.short .zukan-name {
    font-size: 24px;
}

.short .zukan-desc {
    font-size: 16px;
}

.short .howto-window {
    width: 96%;
}

.short .howto-lead {
    font-size: 17px;
    margin-bottom: 6px;
}

.short .howto-item {
    padding: 2px 0;
}

.short .howto-tip {
    font-size: 15px;
    margin: 2px 0 6px 0;
}

.short .pause-window,
.short .complete-window {
    width: 70%;
}

.short .banner {
    top: 70px;
}

.short .toasts {
    top: 200px;
    right: 100px;
}

.short .creature-card {
    top: 14px;
    bottom: auto;
    right: 290px;
    width: 420px;
    padding: 6px 12px 6px 6px;
}

.short .help {
    top: 214px;
    bottom: auto;
}

.short .title-box {
    margin-top: -30px;
}

/* ---- 縦向き ---- */
.portrait .map-window,
.portrait .collection-window,
.portrait .howto-window,
.portrait .complete-window,
.portrait .pause-window,
.portrait .confirm-window {
    width: 94%;
}

.portrait .window {
    padding: 18px 20px 20px 20px;
}

.portrait .collection-window {
    height: 92%;
}

.portrait .map-body,
.portrait .zukan-body {
    flex-direction: column;
}

.portrait .bigmap {
    width: 480px;
    height: 480px;
    align-self: center;
}

.portrait .map-side {
    margin-left: 0;
    margin-top: 10px;
}

.portrait .map-legend {
    max-height: 300px;
}

.portrait .zukan-detail {
    width: auto;
    margin-left: 0;
    margin-top: 8px;
    flex-direction: row;
    align-items: flex-start;
}

.portrait .zukan-text {
    align-items: flex-start;
    margin-left: 12px;
}

.portrait .zukan-img {
    width: 130px;
    height: 130px;
    flex-shrink: 0;
}

.portrait .howto-item {
    width: 100%;
}

.portrait .banner {
    top: 250px;
}

.portrait .toasts {
    top: 360px;
    right: 14px;
}

.portrait .creature-card {
    left: 14px;
    right: 14px;
    width: auto;
    bottom: 330px;
}

.portrait .title-hint {
    left: 20px;
    right: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.portrait .move-zone {
    width: 60%;
    height: 55%;
}

.portrait .touch-buttons {
    right: 20px;
    bottom: 36px;
    flex-direction: column-reverse;
    align-items: flex-end;
}

.portrait .touch-button {
    margin-left: 0;
    margin-top: 14px;
}

.portrait .minimap {
    width: 140px;
    height: 140px;
    border-radius: 70px;
}

.portrait .minimap-mask {
    border-radius: 66px;
}

.portrait .minimap-player {
    left: 51px;
    top: 51px;
}

.portrait .minimap-north {
    left: 56px;
}

.portrait .obj-label {
    font-size: 16px;
    margin-left: 6px;
}

.portrait .obj-count {
    font-size: 18px;
    margin-left: 8px;
}

.portrait .logo {
    font-size: 58px;
    letter-spacing: 4px;
}

.portrait .logo-sub {
    font-size: 18px;
    letter-spacing: 4px;
}

.portrait .prompt {
    bottom: 250px;
}

.portrait .row-buttons {
    flex-wrap: wrap;
}

/* ===================================================================
   糸をねらう・オートセーブ・レア・ファストトラベル・設定
   =================================================================== */
.reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    margin-left: -32px;
    margin-top: -32px;
    align-items: center;
    justify-content: center;
}

.reticle-ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 32px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.55);
    transition-property: border-color, scale;
    transition-duration: 0.15s;
}

.reticle-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.8);
}

.reticle--ok .reticle-ring {
    border-color: rgb(150, 240, 170);
    scale: 0.85 0.85;
}

.reticle--ok .reticle-dot {
    background-color: rgb(150, 240, 170);
}

.reticle--far .reticle-ring {
    border-color: rgba(255, 190, 150, 0.8);
}

.reticle-text {
    position: absolute;
    top: 72px;
    width: 420px;
    -unity-text-align: middle-center;
    font-size: 19px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
}

.save-indicator {
    position: absolute;
    right: 32px;
    bottom: 28px;
    flex-direction: row;
    align-items: center;
    padding: 6px 14px;
    border-radius: 18px;
    background-color: rgba(28, 40, 34, 0.45);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.save-indicator--show {
    opacity: 1;
}

.save-leaf {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-top-left-radius: 2px;
    background-color: rgb(150, 210, 110);
    rotate: 0deg;
    transition-property: rotate;
    transition-duration: 1.2s;
}

.save-indicator--show .save-leaf {
    rotate: 360deg;
}

.save-text {
    margin-left: 8px;
    font-size: 16px;
    color: rgb(230, 245, 220);
}

.touch-ui .save-indicator {
    bottom: auto;
    top: 250px;
    right: 110px;
}

.creature-card--rare {
    border-color: rgb(240, 196, 70);
    background-color: rgba(255, 249, 226, 0.97);
}

.creature-card--rare .creature-card-sub {
    color: rgb(214, 140, 20);
}

.zukan-section {
    width: 100%;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(170, 120, 30);
    margin: 10px 5px 2px 5px;
}

.zukan-card--rare {
    border-color: rgb(236, 196, 92);
    background-color: rgb(255, 248, 224);
}

.zukan-new {
    position: absolute;
    right: 4px;
    top: 4px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(232, 96, 70);
    border-radius: 8px;
    padding: 1px 6px;
}

.legend-go {
    height: 36px;
    min-width: 72px;
    margin-left: 6px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(120, 170, 80);
    background-color: rgb(214, 238, 190);
    color: rgb(60, 90, 40);
    font-size: 15px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.settings {
    max-height: 430px;
}

.settings-head {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(150, 110, 60);
    margin: 8px 0 2px 0;
}

.settings .unity-toggle {
    margin: 4px 0;
}

.short .settings {
    max-height: 250px;
}

.portrait .settings {
    max-height: 560px;
}

/* ===================================================================
   改善：タイトル・読み込み・メニュー・地図・写真モード・クレジット
   =================================================================== */
.title-progress {
    margin-top: 14px;
    font-size: 19px;
    color: rgb(255, 244, 214);
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.75);
    -unity-text-align: middle-center;
}

.btn-small-title {
    height: 44px;
    font-size: 18px;
}

.version {
    position: absolute;
    right: 18px;
    bottom: 12px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
}

.loading-tip {
    margin-top: 26px;
    font-size: 18px;
    color: rgb(190, 214, 176);
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 900px;
}

.pause-summary {
    font-size: 17px;
    color: rgb(130, 106, 76);
    -unity-text-align: middle-center;
    margin: -8px 0 8px 0;
    white-space: normal;
}

.photo-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    font-size: 17px;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
}

.map-hint {
    position: absolute;
    border-radius: 999px;
    border-width: 2px;
    border-color: rgba(150, 235, 255, 0.85);
    background-color: rgba(150, 235, 255, 0.18);
}

.legend-here {
    font-size: 14px;
    color: rgb(255, 255, 255);
    background-color: rgb(120, 170, 80);
    border-radius: 8px;
    padding: 1px 8px;
    margin-left: 6px;
    flex-shrink: 0;
}

.map-creature {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: rgba(255, 220, 110, 0.9);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.9);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(90, 60, 20);
    padding: 0;
}

.zukan-filters {
    flex-direction: row;
    width: 100%;
    margin: 0 5px 4px 5px;
}

.toast--tip {
    border-color: rgba(255, 220, 140, 0.8);
    background-color: rgba(60, 50, 28, 0.62);
}

.credits-window {
    width: 760px;
}

.credits-text {
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(90, 74, 58);
    margin-bottom: 14px;
}

.portrait .credits-window {
    width: 94%;
}

.zukan-filters .chip {
    min-width: 84px;
    height: 34px;
    margin: 0 8px 0 0;
    font-size: 16px;
}
